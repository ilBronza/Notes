{
    "name": "ilbronza/notes",
    "description": "Polymorphic Laravel notes with attachments and notifications",
    "license": "MIT",
    "authors": [
        {
            "name": "Davide Bronzini",
            "email": "davide@sistema.srl",
            "homepage": "https://www.sistema.srl"
        }
    ],
    "homepage": "https://github.com/ilbronza/notes",
    "keywords": [
        "Laravel",
        "Notes"
    ],
    "require": {},
    "require-dev": {},
    "autoload": {
        "psr-4": {
            "IlBronza\\Notes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IlBronza\\Notes\\Tests\\": "tests",
            "App\\": "tests/Fixtures/App/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "IlBronza\\Notes\\NotesServiceProvider"
            ],
            "aliases": {
                "Notes": "IlBronza\\Notes\\Facades\\Notes"
            }
        }
    },
    "suggest": {
        "ilbronza/tasks": "Task management extracted from Notes; required by applications using tasks"
    }
}
